{
	"compilerOptions": {
		"baseUrl": "src",
		"module": "ESNext",
		"target": "ES2018",
		"moduleResolution": "node",
		"strict": true,
		"noImplicitReturns": true,
		"importHelpers": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"lib": ["DOM", "ES2018"]
	},
	"include": ["src/**/*.ts"]
}
