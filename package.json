{
  "name": "vault-to-notion",
  "version": "1.0.0",
  "description": "Publish Obsidian notes to a Notion database.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint ."
  },
  "author": "An Tran Solutions",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3"
  }
}
